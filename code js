/**
 * ResolveIt: website + backend in ONE file (Code.gs). No Index.html needed.
 *
 * SETUP
 * 1. Create a Google Sheet > Extensions > Apps Script.
 * 2. Delete every other file in the project, then paste this ENTIRE file into Code.gs.
 * 3. Deploy > New deployment > Web app > Execute as: Me, Who has access: Anyone.
 * 4. Open the /exec URL: that is the website. ?action=ping is a health check.
 * 5. After ANY edit: Deploy > Manage deployments > pencil icon > Version: New version > Deploy.
 *    (Always edit the existing deployment, never "New deployment", so the URL stays the same.)
 * 6. Pick adminCreateUser in the editor, edit its 4 values, press Run to create the first admin.
 *
 * The website itself is stored at the very bottom of this file (PAGE_B64) and
 * decoded at request time. You never need to edit that part.
 */

var SHEET_NAME = 'Complaints';
var HEADERS = [
  'ComplaintID', 'CreatedAt', 'UpdatedAt', 'Status', 'Category', 'Department',
  'Priority', 'Subject', 'Description', 'Location', 'Anonymous', 'SubmittedBy'
];

// Status order matches the 5-step timeline on the landing page.
var STATUSES = ['Submitted', 'Under Review', 'Assigned', 'In Progress', 'Resolved'];

// Category -> responsible department (from the ResolveIt design).
var DEPARTMENTS = {
  'Classroom': 'Maintenance Cell',
  'Hostel': 'Hostel Administration',
  'Canteen': 'Canteen Management',
  'Library': 'Library Administration',
  'Transport': 'Transport Department',
  'Internet/Wi-Fi': 'IT Department',
  'Cleanliness': 'Maintenance Cell',
  'Electricity': 'Maintenance Cell',
  'Water': 'Maintenance Cell',
  'Laboratory': 'IT Department',
  'Academic Issues': 'Academic Office',
  'Other': 'Administration'
};
var PRIORITIES = ['Low', 'Medium', 'High', 'Emergency'];

/* ------------------------------------------------------------ ENTRY POINTS */
function doGet(e) {
  var p = (e && e.parameter) || {};
  if (p.action === 'ping') return json_({ ok: true, service: 'ResolveIt API' });
  if (p.action === 'track') return json_(route_({ action: 'track', id: p.id }));
  // Default: serve the website (embedded at the bottom of this file)
  return HtmlService.createHtmlOutput(pageHtml_())
    .setTitle('ResolveIt \u2014 College Complaint Resolution System')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover');
}

// For pages hosted elsewhere that call this web app with fetch() (text/plain body).
function doPost(e) {
  var body = {};
  try { body = JSON.parse((e && e.postData && e.postData.contents) || '{}'); } catch (err) { /* handled below */ }
  return json_(route_(body));
}

// Called by Index.html through google.script.run.rpc(...)
function rpc(body) { return route_(body || {}); }

function route_(body) {
  try {
    switch (body.action) {
      case 'submit':   return submit_(body);
      case 'track':    return track_(body.id);
      case 'register': return register_(body);
      case 'login':    return login_(body);
      case 'me':       return me_(body.token);
      case 'logout':   return logout_(body.token);
      case 'forgot':   return forgot_(body);
      case 'reset':    return reset_(body);
      case 'ping':     return { ok: true, service: 'ResolveIt API', time: new Date().toISOString() };
      default:         return { ok: false, error: 'Unknown action' };
    }
  } catch (err) {
    return { ok: false, error: String(err && err.message || err) };
  }
}

/* ------------------------------------------------------------- submit */
function submit_(b) {
  var who = sessionFromToken_(b.token);
  if (!who) return { ok: false, error: 'Please log in to submit a complaint.' };
  var subject = clean_(b.subject, 120);
  var description = clean_(b.description, 2000);
  if (!subject || !description) return { ok: false, error: 'Subject and description are required.' };

  var category = DEPARTMENTS[b.category] ? b.category : 'Other';
  var priority = PRIORITIES.indexOf(b.priority) >= 0 ? b.priority : 'Medium';
  var anonymous = b.anonymous === true || b.anonymous === 'true';

  var lock = LockService.getScriptLock();
  lock.waitLock(10000); // stop two simultaneous submissions getting the same ID
  try {
    var sheet = sheet_();
    var id = 'CMP' + (1000 + Math.max(sheet.getLastRow() - 1, 0) + 1);
    var now = new Date();
    sheet.appendRow([
      id, now, now, STATUSES[0], category, DEPARTMENTS[category],
      priority, subject, description, clean_(b.location, 120),
      anonymous ? 'Yes' : 'No',
      anonymous ? '' : who.name + ' <' + who.email + '>'   // taken from the session, never from the client
    ]);
    return { ok: true, id: id, status: STATUSES[0], department: DEPARTMENTS[category] };
  } finally {
    lock.releaseLock();
  }
}

/* -------------------------------------------------------------- track */
function track_(rawId) {
  var id = String(rawId || '').toUpperCase().replace(/\s+/g, '');
  if (!/^CMP\d{3,6}$/.test(id)) return { ok: false, error: 'Invalid complaint ID.' };

  var sheet = sheet_();
  var last = sheet.getLastRow();
  if (last < 2) return { ok: true, found: false };

  var rows = sheet.getRange(2, 1, last - 1, HEADERS.length).getValues();
  for (var i = 0; i < rows.length; i++) {
    if (rows[i][0] === id) {
      var r = rows[i];
      var status = String(r[3]);
      var stage = Math.max(STATUSES.indexOf(status), 0);
      // Deliberately omits SubmittedBy and Description: tracking is by ID only.
      return {
        ok: true,
        found: true,
        ticket: {
          id: id,
          title: String(r[7]),
          dept: String(r[5]),
          where: String(r[9] || r[4]),
          stage: stage,
          status: STATUSES[stage],
          updated: Utilities.formatDate(new Date(r[2]), Session.getScriptTimeZone(), 'MMM dd, hh:mm a')
        }
      };
    }
  }
  return { ok: true, found: false };
}

/* ------------------------------------------------------------ helpers */
function sheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(SHEET_NAME);
    sh.appendRow(HEADERS);
    sh.setFrozenRows(1);
  }
  return sh;
}

function clean_(v, max) {
  var s = String(v == null ? '' : v).trim().slice(0, max);
  // Stop spreadsheet formula injection (=, +, -, @ at the start of a cell)
  return /^[=+\-@]/.test(s) ? "'" + s : s;
}

function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}


/* =====================================================================
   AUTH: register / login / session / logout
   Accounts live in a "Users" sheet. Passwords are never stored: only a
   per-user random salt and a stretched SHA-256 hash. (Apps Script has no
   bcrypt/argon2; for a college project this is reasonable, for anything
   holding sensitive data put real auth, e.g. Google Sign-In, in front.)
   ===================================================================== */
var USERS_SHEET = 'Users';
var USER_HEADERS = ['Email', 'Role', 'Name', 'Salt', 'PasswordHash', 'CreatedAt', 'Active'];
var ROLES = ['student', 'staff', 'admin'];
var HASH_ROUNDS = 300;
var SESSION_SECONDS = 21600;   // 6 hours (CacheService maximum)
var MAX_FAILS = 5;             // failed logins allowed per email ...
var LOCKOUT_SECONDS = 900;     // ... within 15 minutes

function register_(b) {
  // Self-service sign-up creates STUDENT accounts only.
  // Staff and admin accounts are created by you with adminCreateUser() below.
  var name = clean_(b.name, 80);
  var email = normEmail_(b.email);
  var pw = String(b.password || '');
  if (!name) return { ok: false, error: 'Enter your full name.' };
  if (!validEmail_(email)) return { ok: false, error: 'Enter a valid email address.' };
  if (pw.length < 8 || pw.length > 128) return { ok: false, error: 'Password must be 8 to 128 characters.' };

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    if (findUser_(email)) return { ok: false, error: 'An account with this email already exists. Try logging in.' };
    var salt = Utilities.getUuid();
    usersSheet_().appendRow([email, 'student', name, salt, hash_(pw, salt), new Date(), 'Yes']);
    return startSession_({ email: email, role: 'student', name: name });
  } finally {
    lock.releaseLock();
  }
}

function login_(b) {
  var email = normEmail_(b.email);
  var pw = String(b.password || '');
  var role = ROLES.indexOf(b.role) >= 0 ? b.role : 'student';
  if (!email || !pw) return { ok: false, error: 'Enter your email and password.' };

  var cache = CacheService.getScriptCache();
  var failKey = 'fail:' + email;
  var fails = Number(cache.get(failKey) || 0);
  if (fails >= MAX_FAILS) return { ok: false, error: 'Too many attempts. Please try again in 15 minutes.' };

  var u = findUser_(email);
  // Always hash, even for unknown emails, so response time does not reveal which emails exist.
  var computed = hash_(pw, u ? u.salt : 'no-such-user');
  var good = u && u.active && u.role === role && safeEqual_(computed, u.hash);
  if (!good) {
    cache.put(failKey, String(fails + 1), LOCKOUT_SECONDS);
    return { ok: false, error: 'Incorrect email or password for this portal.' };
  }
  cache.remove(failKey);
  return startSession_(u);
}

function sessionFromToken_(token) {
  var raw = CacheService.getScriptCache().get('s:' + String(token || ''));
  return raw ? JSON.parse(raw) : null;
}

function me_(token) {
  var user = sessionFromToken_(token);
  if (!user) return { ok: false, error: 'Session expired. Please log in again.' };
  return { ok: true, user: user };
}

function logout_(token) {
  CacheService.getScriptCache().remove('s:' + String(token || ''));
  return { ok: true };
}

/**
 * Run this ONCE from the Apps Script editor to create a staff or admin account.
 * Edit the four values, press Run, then delete the password from the code.
 */
function adminCreateUser() {
  var EMAIL = 'admin@college.edu';
  var NAME = 'Campus Admin';
  var ROLE = 'admin';              // 'staff' or 'admin'
  var PASSWORD = 'ChangeMe-12345'; // at least 8 characters
  if (ROLES.indexOf(ROLE) < 0) throw new Error('ROLE must be student, staff or admin');
  var email = normEmail_(EMAIL);
  if (findUser_(email)) throw new Error('User already exists: ' + email);
  var salt = Utilities.getUuid();
  usersSheet_().appendRow([email, ROLE, NAME, salt, hash_(PASSWORD, salt), new Date(), 'Yes']);
  Logger.log('Created ' + ROLE + ' account for ' + email);
}

/* ---- auth helpers ---- */
function startSession_(u) {
  var token = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
  var user = { email: u.email, role: u.role, name: u.name };
  CacheService.getScriptCache().put('s:' + token, JSON.stringify(user), SESSION_SECONDS);
  return { ok: true, token: token, user: user };
}

function usersSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(USERS_SHEET);
  if (!sh) {
    sh = ss.insertSheet(USERS_SHEET);
    sh.appendRow(USER_HEADERS);
    sh.setFrozenRows(1);
  }
  return sh;
}

function findUser_(email) {
  var sh = usersSheet_();
  var last = sh.getLastRow();
  if (last < 2) return null;
  var rows = sh.getRange(2, 1, last - 1, USER_HEADERS.length).getValues();
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i][0]).toLowerCase() === email) {
      return {
        row: i + 2,
        email: String(rows[i][0]), role: String(rows[i][1]), name: String(rows[i][2]),
        salt: String(rows[i][3]), hash: String(rows[i][4]),
        active: String(rows[i][6]).toLowerCase() !== 'no'
      };
    }
  }
  return null;
}

function hash_(password, salt) {
  var digest = salt + '|' + password;
  for (var i = 0; i < HASH_ROUNDS; i++) {
    var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, digest + i, Utilities.Charset.UTF_8);
    digest = bytes.map(function (x) { return ('0' + (x & 0xff).toString(16)).slice(-2); }).join('');
  }
  return digest;
}

function safeEqual_(a, b) {
  a = String(a); b = String(b);
  if (a.length !== b.length) return false;
  var diff = 0;
  for (var i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

function normEmail_(v) { return String(v || '').trim().toLowerCase().slice(0, 120); }
function validEmail_(e) { return /^[a-z0-9][^@\s]*@[^@\s]+\.[^@\s]+$/.test(e); }


/* =====================================================================
   PASSWORD RESET (emails a 6-digit code; needs the Mail permission,
   which Apps Script asks you to approve the first time you deploy)
   ===================================================================== */
var RESET_SECONDS = 600;       // code valid for 10 minutes
var RESET_MAX_REQUESTS = 3;    // code requests per email per hour
var RESET_MAX_TRIES = 5;       // wrong codes before the code is discarded

function forgot_(b) {
  var email = normEmail_(b.email);
  if (!validEmail_(email)) return { ok: false, error: 'Enter a valid email address.' };

  var cache = CacheService.getScriptCache();
  var reqKey = 'resetreq:' + email;
  var n = Number(cache.get(reqKey) || 0);
  if (n >= RESET_MAX_REQUESTS) return { ok: false, error: 'Too many reset requests. Please try again in an hour.' };
  cache.put(reqKey, String(n + 1), 3600);

  var u = findUser_(email);
  if (u && u.active) {
    var code = String(parseInt(Utilities.getUuid().replace(/-/g, '').slice(0, 8), 16) % 900000 + 100000);
    cache.put('reset:' + email, JSON.stringify({ code: code, tries: 0 }), RESET_SECONDS);
    MailApp.sendEmail({
      to: email,
      subject: 'Your ResolveIt password reset code',
      body: 'Hi ' + u.name + ',\n\nYour ResolveIt password reset code is ' + code +
            '.\nIt expires in 10 minutes.\n\nIf you did not ask for this, you can ignore this email.'
    });
  }
  // Same answer whether or not the account exists, so emails cannot be probed.
  return { ok: true, message: 'If that email has an account, a 6-digit code has been sent. It expires in 10 minutes.' };
}

function reset_(b) {
  var email = normEmail_(b.email);
  var code = String(b.code || '').trim();
  var pw = String(b.password || '');
  if (pw.length < 8 || pw.length > 128) return { ok: false, error: 'Password must be 8 to 128 characters.' };

  var cache = CacheService.getScriptCache();
  var key = 'reset:' + email;
  var raw = cache.get(key);
  if (!raw) return { ok: false, error: 'That code is invalid or has expired. Please request a new one.' };
  var st = JSON.parse(raw);
  if (st.tries >= RESET_MAX_TRIES) { cache.remove(key); return { ok: false, error: 'Too many wrong codes. Please request a new one.' }; }
  if (!safeEqual_(code, st.code)) {
    st.tries += 1;
    cache.put(key, JSON.stringify(st), RESET_SECONDS);
    return { ok: false, error: 'That code is incorrect.' };
  }

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var u = findUser_(email);
    if (!u) return { ok: false, error: 'That code is invalid or has expired. Please request a new one.' };
    var salt = Utilities.getUuid();
    usersSheet_().getRange(u.row, 4, 1, 2).setValues([[salt, hash_(pw, salt)]]);
    cache.remove(key);
    cache.remove('fail:' + email);   // clear any login lockout
    return { ok: true, message: 'Password updated. You can log in now.' };
  } finally {
    lock.releaseLock();
  }
}


